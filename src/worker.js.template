const GEOCODE_CACHE_VERSION='network-v5';
async function geocode(request){
  const q=(new URL(request.url).searchParams.get('q')||'').trim();
  if(request.method!=='GET'||!q||q.length>500)return Response.json({error:'Invalid query'},{status:400,headers:{'Cache-Control':'no-store'}});
  const cache=globalThis.caches?.default;
  const cacheKey=new Request(new URL('/__geocode-cache/'+GEOCODE_CACHE_VERSION+'?q='+encodeURIComponent(q),request.url));
  const reply=(response,state)=>{const headers=new Headers(response.headers);headers.set('Cache-Control','no-store');headers.set('X-Geocode-Cache',state);headers.set('X-Geocode-Provider','nominatim');return new Response(response.body,{headers})};
  if(cache){try{const saved=await cache.match(cacheKey);if(saved)return reply(saved,'HIT')}catch{}}
  try{
    const upstream='https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&limit=5&countrycodes=tw&q='+encodeURIComponent(q);
    const r=await fetch(upstream,{headers:{'User-Agent':'TaipeiPark/1.0 (https://taipeipark.audihsu.chatgpt.site)','Accept-Language':'zh-TW'},signal:AbortSignal.timeout(10000)});
    if(!r.ok)return Response.json({error:'地址服務暫時不可用'},{status:502,headers:{'Cache-Control':'no-store','X-Geocode-Provider':'nominatim'}});
    const rows=await r.json();if(!Array.isArray(rows))throw Error('Invalid upstream geocoding data');
    const response=Response.json(rows,{headers:{'Cache-Control':'public, max-age='+(rows.length?86400:60),'X-Geocode-Provider':'nominatim','X-Geocode-Fetched-At':new Date().toISOString()}});
    let stored=false;if(cache){try{await cache.put(cacheKey,response.clone());stored=true}catch{}}
    return reply(response,stored?'MISS':'BYPASS');
  }catch{return Response.json({error:'地址服務逾時或回傳格式無效'},{status:502,headers:{'Cache-Control':'no-store','X-Geocode-Provider':'nominatim'}})}
}

