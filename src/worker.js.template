  for(const r of body.rows){if(r.length!==cols.length||typeof r[0]!=='string'||r[0].length>200)return Response.json({error:'Invalid row'},{status:400});if(body.kind!=='conflicts'){const offset=body.kind==='doors'?2:1;if(!Number.isInteger(r[offset])||!Number.isInteger(r[offset+1])||r[offset]<247000000||r[offset]>255000000||r[offset+1]<1213000000||r[offset+1]>1218000000)return Response.json({error:'Invalid coordinates'},{status:400})}}
