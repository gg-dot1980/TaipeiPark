async function d1Address(request,env){
 const unavailable=()=>Response.json({error:'Official address snapshot unavailable',unavailable:true},{status:503});
 try{
  if(!env.DB)return unavailable();
  const snap=await env.DB.prepare('SELECT state,index_sha256 FROM address_snapshot WHERE snapshot_id=?').bind(D1_SNAPSHOT_ID).first();
  if(snap?.state!=='verified'||snap.index_sha256!==D1_INDEX_SHA)return unavailable();
  const q=(new URL(request.url).searchParams.get('q')||'').normalize('NFKC').replace(/臺/g,'台').replace(/\s+/g,'').replace(/之/g,'-'),key=q.replace(/^台北市/,'');
  if(request.method!=='GET'||!q||q.length>200)return Response.json({error:'Invalid address'},{status:400});
  const reply=value=>Response.json(value,{headers:{'Cache-Control':'public, max-age=86400','X-Data-Source':value.provider==='verified-address'?'Cross-checked official address and independent site map':'Taipei Civil Affairs official address snapshot'}});
  if(!/^[^,，、]+\d+(?:-\d+)*號(?:-\d+)?$/.test(key))return reply({match:null,reason:'Single exact door required'});
  const hasDistrict=/^[^路街\d]{1,4}區/.test(key),column=hasDistrict?'address_key':'districtless_key';
  const conflict=await env.DB.prepare('SELECT address_key FROM address_conflict WHERE snapshot_id=? AND '+column+'=? LIMIT 1').bind(D1_SNAPSHOT_ID,key).first();
  if(conflict)return reply({match:null,blocked:true,reason:'Official address coordinates conflict',source:ADDRESS_META.source,updated:ADDRESS_META.sourceUpdated});
  const result=await env.DB.prepare('SELECT address_key,lat_e7,lon_e7 FROM address_door WHERE snapshot_id=? AND '+column+'=? LIMIT 2').bind(D1_SNAPSHOT_ID,key).all();
  const rows=result.results;
  if(rows.length===1){const r=rows[0];return reply({match:{address:'臺北市'+r.address_key,lat:r.lat_e7/1e7,lon:r.lon_e7/1e7},source:ADDRESS_META.source,updated:ADDRESS_META.sourceUpdated,sha256:ADDRESS_META.sha256,precision:'official-address-point'})}
  if(!rows.length){const r=await env.DB.prepare('SELECT evidence_json FROM address_reference WHERE snapshot_id=? AND address_key=?').bind(D1_SNAPSHOT_ID,key).first();if(r){const v=JSON.parse(r.evidence_json);return reply({match:{address:v.address,name:v.name,lat:v.lat,lon:v.lon},provider:'verified-address',source:v.coordinateSource,addressSource:v.addressSource,checkedAt:VERIFIED_ADDRESS_REFERENCES.checkedAt,precision:'address-reference'})}}
  return reply({match:null,reason:rows.length?'Ambiguous address':'No exact official address'});
 }catch{return unavailable()}
}
